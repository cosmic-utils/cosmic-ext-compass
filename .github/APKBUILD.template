# Maintainer: Frederic Laing <dev@cosmic-utils.org>
pkgname=cosmic-ext-compass
pkgver=@@VERSION@@
pkgrel=0
pkgdesc="Responsive magnetic compass for Linux"
url="https://cosmic-utils.org"
arch="all !armhf !armv7 !x86"
license="GPL-3.0-only"
makedepends="cargo-auditable just libxkbcommon-dev pkgconf wayland-dev"
options="net"
source="$pkgname-$pkgver.tar.gz::https://github.com/cosmic-utils/cosmic-ext-compass/archive/refs/tags/v$pkgver.tar.gz"

prepare() {
    default_prepare
    cargo fetch --target="$CHOST" --locked
}

build() {
    export COMPASS_VERSION=$pkgver
    cargo auditable build --release --frozen
}

check() { cargo test --frozen; }
package() { just rootdir="$pkgdir" install; }

sha512sums="
@@CHECKSUM@@  cosmic-ext-compass-@@VERSION@@.tar.gz
"
