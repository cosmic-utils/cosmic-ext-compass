# Native x86_64 musl build image with only GUI runtime headers.
FROM alpine@sha256:020dfcbaaf4cc1078bf2d9c7ba31a8466e334061dcd2f248001d68f79e52c000

RUN apk add --no-cache \
    alpine-keys \
    build-base \
    curl \
    pkgconf \
    wayland-dev \
    libxkbcommon-dev

ARG RUST_VERSION=1.98.0
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"
# Pin the rustup 1.29.3 installer; sh.rustup.rs changes independently of its checksum.
RUN curl --proto '=https' --tlsv1.2 -fsSL https://raw.githubusercontent.com/rust-lang/rustup/edbc831cec44dc2858a4a4dce768c74361d027dc/rustup-init.sh -o /tmp/rustup-init.sh && \
    printf '%s  %s\n' d890e2fef6fa991b19cde2e608199bc1dca4e37f41f884edf8849ff693048de6 /tmp/rustup-init.sh | sha256sum -c - && \
    sh /tmp/rustup-init.sh -y --default-toolchain "${RUST_VERSION}" --target x86_64-unknown-linux-musl && \
    rm /tmp/rustup-init.sh

ENV CC_x86_64_unknown_linux_musl=gcc \
    PKG_CONFIG_ALLOW_CROSS=1 \
    RUSTFLAGS="-C target-feature=-crt-static"
