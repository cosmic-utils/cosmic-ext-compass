# Native x86_64 musl build image with only GUI runtime headers.
FROM alpine@sha256:020dfcbaaf4cc1078bf2d9c7ba31a8466e334061dcd2f248001d68f79e52c000

RUN apk add --no-cache \
    alpine-keys \
    build-base \
    curl \
    pkgconf \
    wayland-dev \
    libxkbcommon-dev

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"
COPY rust-toolchain.toml /tmp/rust-toolchain.toml
# Pin the installer itself, not the mutable sh.rustup.rs bootstrap script.
RUN RUST_VERSION="$(sed -n 's/^[[:space:]]*channel[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' /tmp/rust-toolchain.toml)" && \
    test -n "${RUST_VERSION}" && \
    curl --proto '=https' --tlsv1.2 -fsSL https://static.rust-lang.org/rustup/archive/1.29.3/x86_64-unknown-linux-musl/rustup-init -o /tmp/rustup-init && \
    printf '%s  %s\n' 1552169aba2836777136ccff7a381e95c17233b5d8250cd5e10ae3cb971bfcfc /tmp/rustup-init | sha256sum -c - && \
    chmod +x /tmp/rustup-init && \
    /tmp/rustup-init -y --default-toolchain "${RUST_VERSION}" --target x86_64-unknown-linux-musl && \
    rm /tmp/rustup-init /tmp/rust-toolchain.toml

ENV CC_x86_64_unknown_linux_musl=gcc \
    PKG_CONFIG_ALLOW_CROSS=1 \
    RUSTFLAGS="-C target-feature=-crt-static"
